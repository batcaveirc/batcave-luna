# Copy to .env for local runs. On GitHub Actions these are repo Secrets
# instead — never commit a filled-in .env, this repo is public.

# ── Required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_GUILD_ID=
OWNER_IDS=                       # comma-separated Discord user IDs
IRC_NICKSERV_PASS=

# ── IRC (defaults in the workflow already point at the emoji room) ──────────
IRC_SERVER=irc.hybridirc.com
IRC_PORT=6697
IRC_NICK=Luna1
IRC_CHANNEL=#🅱🅰🆃🅲🅰🆅🅴

# ── Discord side of the bridge ─────────────────────────────────────────────
BRIDGE_CHANNEL=🅱🅰🆃🅲🅰🆅🅴     # Discord channel NAME (no #)
NSFW_CHANNEL=nsfw
ALERT_CHANNEL=bot-logs
MOD_ROLE=

# ── Identity, kept out of source because the repo is public ────────────────
LUNA_CREDIT=                     # shown in !!about, e.g. a nickname
LUNA_OWNERS_IRC=                 # comma-separated IRC nicks
LUNA_PRIMARY_OWNER=              # single IRC nick with full trust

# ── Optional ───────────────────────────────────────────────────────────────
STARALIGN_RELAY_URL=
STARALIGN_RELAY_SECRET=
LUNA_BRAWL=0                     # 1 re-enables the brawl game (off: it spams)

# Optional: extra notsobot commands IRC may trigger (comma-separated)
NOTSOBOT_EXTRA_CMDS=
